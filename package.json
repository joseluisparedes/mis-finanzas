{
  "name": "gestor-financiero",
  "version": "1.0.0",
  "type": "module",
  "description": "Aplicación para gestionar finanzas personales con Supabase",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build",
    "start": "vite preview --port 4173 --host",
    "health-check": "node scripts/system-health-check.js",
    "test-system": "chmod +x scripts/run-health-check.sh && ./scripts/run-health-check.sh",
    "validate": "npm run health-check && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "@tanstack/react-query": "^5.85.3",
    "@tanstack/react-query-devtools": "^5.85.3",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.8.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.15",
    "dotenv": "^16.6.1",
    "postcss": "^8.4.28",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5",
    "vite-plugin-pwa": "^1.0.3"
  }
}
